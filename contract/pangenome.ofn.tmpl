Prefix(:=<https://w3id.org/research-commons/v0.1/>)
Prefix(pg:=<https://w3id.org/academic-wasteland/pangenome-town/contract/>)
Prefix(town:=<{{TOWN_IRI}}>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Ontology(<{{TOWN_IRI}}contract/ontology>
 Declaration(Class(:ResearchTask))
 Declaration(Class(:ResearchRequest))
 Declaration(Class(:ResearchContribution))
 Declaration(Class(:Actor))
 Declaration(Class(:Agent))
 Declaration(Class(:Person))
 Declaration(Class(:Organization))
 Declaration(Class(:Dataset))
 Declaration(Class(:PublicDataset))
 Declaration(Class(:RestrictedDataset))
 Declaration(Class(:ResearchArtifact))
 Declaration(Class(:Claim))
 Declaration(Class(:Evidence))
 Declaration(Class(pg:PangenomeQueryTask))
 Declaration(Class(pg:BasicQueryTask))
 Declaration(Class(pg:LargeAnalysisTask))
 Declaration(Class(pg:GraphSummaryTask))
 Declaration(Class(pg:RegionExtractionTask))
 Declaration(Class(pg:HaplotypePresenceTask))
 Declaration(Class(pg:RegionVariantListingTask))
 Declaration(Class(pg:GeneLookupTask))
 Declaration(Class(pg:ReadMappingVariantCallingTask))
 Declaration(Class(pg:WholeGraphDeconstructTask))
 Declaration(Class(pg:PopulationComparisonTask))
 Declaration(Class(pg:PangenomeGraph))
 Declaration(Class(pg:GenomicRegion))
 Declaration(Class(pg:GRCh38Region))
 Declaration(Class(pg:CHM13Region))
 Declaration(Class(pg:Gene))
 Declaration(Class(pg:ReadSet))
 Declaration(Class(pg:ReputableRequester))
 Declaration(Class(pg:UnvettedRequester))
 Declaration(Class(pg:BlockedRequester))
 Declaration(Class(town:ServedGraph))
 Declaration(Class(town:AcceptedBasicTask))
 Declaration(Class(town:AcceptedLargeTask))
 Declaration(Class(town:AcceptedTask))
 Declaration(Class(town:PermissionRequiredTask))
 Declaration(Class(town:RejectedTask))
 Declaration(Class(town:ConformingContribution))
 Declaration(ObjectProperty(:requestedBy))
 Declaration(ObjectProperty(:onBehalfOf))
 Declaration(ObjectProperty(:producedBy))
 Declaration(ObjectProperty(:usesDataset))
 Declaration(ObjectProperty(:hasOutput))
 Declaration(ObjectProperty(:hasClaim))
 Declaration(ObjectProperty(:hasEvidence))
 Declaration(ObjectProperty(:addresses))
 Declaration(ObjectProperty(:partOfRequest))
 Declaration(ObjectProperty(:delegatesTo))
 Declaration(NamedIndividual(<{{TOWN_IRI}}graphs/{{GRAPH_ID}}>))

 SubClassOf(:Agent :Actor)
 SubClassOf(:Person :Actor)
 SubClassOf(:Organization :Actor)
 SubClassOf(:PublicDataset :Dataset)
 SubClassOf(:RestrictedDataset :Dataset)
 DisjointClasses(:PublicDataset :RestrictedDataset)

 SubClassOf(pg:PangenomeQueryTask :ResearchTask)
 SubClassOf(pg:BasicQueryTask pg:PangenomeQueryTask)
 SubClassOf(pg:LargeAnalysisTask pg:PangenomeQueryTask)
 DisjointClasses(pg:BasicQueryTask pg:LargeAnalysisTask)
 SubClassOf(pg:GraphSummaryTask pg:BasicQueryTask)
 SubClassOf(pg:RegionExtractionTask pg:BasicQueryTask)
 SubClassOf(pg:HaplotypePresenceTask pg:BasicQueryTask)
 SubClassOf(pg:RegionVariantListingTask pg:BasicQueryTask)
 SubClassOf(pg:GeneLookupTask pg:BasicQueryTask)
 SubClassOf(pg:ReadMappingVariantCallingTask pg:LargeAnalysisTask)
 SubClassOf(pg:WholeGraphDeconstructTask pg:LargeAnalysisTask)
 SubClassOf(pg:PopulationComparisonTask pg:LargeAnalysisTask)

 SubClassOf(pg:PangenomeGraph :PublicDataset)
 SubClassOf(pg:GenomicRegion :Dataset)
 SubClassOf(pg:GRCh38Region pg:GenomicRegion)
 SubClassOf(pg:CHM13Region pg:GenomicRegion)
 DisjointClasses(pg:GRCh38Region pg:CHM13Region)
 SubClassOf(pg:Gene :Dataset)
 SubClassOf(pg:ReadSet :Dataset)

 SubClassOf(pg:RegionExtractionTask ObjectSomeValuesFrom(:usesDataset pg:GenomicRegion))
 SubClassOf(pg:HaplotypePresenceTask ObjectSomeValuesFrom(:usesDataset pg:GenomicRegion))
 SubClassOf(pg:RegionVariantListingTask ObjectSomeValuesFrom(:usesDataset pg:GenomicRegion))
 SubClassOf(pg:GeneLookupTask ObjectSomeValuesFrom(:usesDataset pg:Gene))
 SubClassOf(pg:ReadMappingVariantCallingTask ObjectSomeValuesFrom(:usesDataset pg:ReadSet))
 SubClassOf(pg:PopulationComparisonTask ObjectSomeValuesFrom(:usesDataset pg:GenomicRegion))

 SubClassOf(pg:ReputableRequester :Actor)
 SubClassOf(pg:UnvettedRequester :Actor)
 SubClassOf(pg:BlockedRequester :Actor)
 DisjointClasses(pg:ReputableRequester pg:UnvettedRequester pg:BlockedRequester)

 ClassAssertion(pg:PangenomeGraph <{{TOWN_IRI}}graphs/{{GRAPH_ID}}>)
 SubClassOf(town:ServedGraph pg:PangenomeGraph)
 ClassAssertion(town:ServedGraph <{{TOWN_IRI}}graphs/{{GRAPH_ID}}>)

 EquivalentClasses(town:AcceptedBasicTask ObjectIntersectionOf(pg:BasicQueryTask ObjectSomeValuesFrom(:usesDataset town:ServedGraph) ObjectSomeValuesFrom(:requestedBy ObjectIntersectionOf(:Actor ObjectComplementOf(pg:BlockedRequester)))))
 EquivalentClasses(town:AcceptedLargeTask ObjectIntersectionOf(pg:LargeAnalysisTask ObjectSomeValuesFrom(:usesDataset town:ServedGraph) ObjectSomeValuesFrom(:requestedBy pg:ReputableRequester)))
 EquivalentClasses(town:AcceptedTask ObjectUnionOf(town:AcceptedBasicTask town:AcceptedLargeTask))
 EquivalentClasses(town:PermissionRequiredTask ObjectIntersectionOf(pg:LargeAnalysisTask ObjectSomeValuesFrom(:usesDataset town:ServedGraph) ObjectSomeValuesFrom(:requestedBy pg:UnvettedRequester)))
 EquivalentClasses(town:RejectedTask ObjectUnionOf(ObjectIntersectionOf(:ResearchTask ObjectSomeValuesFrom(:usesDataset :RestrictedDataset)) ObjectIntersectionOf(:ResearchTask ObjectSomeValuesFrom(:requestedBy pg:BlockedRequester))))
 EquivalentClasses(town:ConformingContribution ObjectIntersectionOf(:ResearchContribution ObjectSomeValuesFrom(:producedBy :Agent) ObjectSomeValuesFrom(:hasOutput :ResearchArtifact) ObjectSomeValuesFrom(:hasEvidence :Evidence)))
)
