[Unit]
Description=Public HTTPS route to laptop Wasteland live visitor demo
After=network-online.target wasteland-public-demo.service
Wants=wasteland-public-demo.service

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -T -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -R 127.0.0.1:8397:127.0.0.1:8395 lc2
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
